#: src/batt.c:61
msgid "Battery number to monitor"
msgstr "ელემენტების რაოდენობა მონიტორინგისთვის"

#: src/batt.c:234
#, c-format
msgid "Charging : %d%%"
msgstr "იმუხტება : %d%%"

#: src/batt.c:236
#, c-format
msgid ""
"Charging : %d%%\n"
"Time remaining : %d minutes"
msgstr ""
"იმუხტება : %d%%\n"
"დარჩენილი დრო : %d წუთი"

#: src/batt.c:238
#, c-format
msgid ""
"Charging : %d%%\n"
"Time remaining : %0.1f hours"
msgstr ""
"იმუხტება : %d%%\n"
"დარჩენილი დრო : %0.1f საათი"

#: src/batt.c:243
#, c-format
msgid ""
"Charged : %d%%\n"
"On external power"
msgstr ""
"დამუხტულია : %d%%\n"
"გარე კვებაზე"

#: src/batt.c:249
#, c-format
msgid "Discharging : %d%%"
msgstr "იცლება : %d%%"

#: src/batt.c:251
#, c-format
msgid ""
"Discharging : %d%%\n"
"Time remaining : %d minutes"
msgstr ""
"იცლება : %d%%\n"
"დარჩენილი დრო : %d წთ"

#: src/batt.c:253
#, c-format
msgid ""
"Discharging : %d%%\n"
"Time remaining : %0.1f hours"
msgstr ""
"იცლება : %d%%\n"
"დარჩენილი დრო : %0.1f სთ"

#: src/batt.c:382
msgid "Monitors laptop battery"
msgstr "თვალყურს ადევნებს ნოუთბუქის ელემენტს"

